<%- include('../layout/header') %>

<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card-premium border-0 p-2">
        <div class="bg-dark text-white text-center py-5 rounded-4 mb-2">
          <h2 class="playfair mb-0">CẬP NHẬT SẢN PHẨM</h2>
          <p class="small text-white-50 mt-2">Chỉnh sửa thông tin sản phẩm: <strong><%= noiThat.tenNoiThat %></strong></p>
        </div>
        <div class="card-body p-4 p-md-5">
          <form action="/products/update/<%= noiThat._id %>" method="POST" enctype="multipart/form-data">
            <div class="row g-4">
              <div class="col-md-6">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 1px;">Mã sản phẩm</label>
                <input type="text" class="form-control border-0 bg-light p-3 rounded-3" name="mNoiThat" value="<%= noiThat.mNoiThat %>" required>
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 1px;">Tên sản phẩm <span class="text-danger">*</span></label>
                <input type="text" class="form-control border-0 bg-light p-3 rounded-3" name="tenNoiThat" value="<%= noiThat.tenNoiThat %>" required>
              </div>
              <div class="col-md-4">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 1px;">Giá (VNĐ) <span class="text-danger">*</span></label>
                <input type="number" class="form-control border-0 bg-light p-3 rounded-3" name="gia" value="<%= noiThat.gia %>" min="1" required>
              </div>
              <div class="col-md-4">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 1px;">Đơn vị tính <span class="text-danger">*</span></label>
                <input type="text" class="form-control border-0 bg-light p-3 rounded-3" name="donViTinh" value="<%= noiThat.donViTinh %>" required>
              </div>
              <div class="col-md-4">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 1px;">Xuất xứ <span class="text-danger">*</span></label>
                <input type="text" class="form-control border-0 bg-light p-3 rounded-3" name="xuatXu" value="<%= noiThat.xuatXu %>" required>
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 1px;">Danh mục</label>
                <select class="form-select border-0 bg-light p-3 rounded-3" name="loaiNoiThat">
                  <% loaiNoiThatList.forEach(function(loai) { %>
                    <option value="<%= loai.tenLoai %>" <%= (noiThat.loaiNoiThat === loai.tenLoai) ? 'selected' : '' %>><%= loai.tenLoai %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 1px;">Tồn kho</label>
                <input type="number" class="form-control border-0 bg-light p-3 rounded-3" name="tonKho" value="<%= noiThat.tonKho %>" min="0">
              </div>
              <div class="col-12">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 1px;">Hình ảnh mới <small class="text-muted fw-normal">(Để trống nếu không thay đổi)</small></label>
                <input type="file" class="form-control border-0 bg-light p-3 rounded-3" name="hinhAnh" accept="image/png, image/jpeg, image/webp">
                <% if (noiThat.hinhAnh) { %>
                  <div class="mt-3 p-3 bg-light rounded-3 d-inline-block">
                    <small class="text-muted d-block mb-2">Ảnh hiện tại:</small>
                    <img src="<%= noiThat.hinhAnh %>" alt="Current" style="max-height: 120px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                  </div>
                <% } %>
              </div>
              <div class="col-12">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 1px;">Mô tả sản phẩm</label>
                <textarea class="form-control border-0 bg-light p-3 rounded-3" name="moTa" rows="6"><%= noiThat.moTa || '' %></textarea>
              </div>
            </div>
            
            <div class="d-flex gap-3 mt-5">
              <a href="/products" class="btn btn-outline-premium px-4 py-3">← Quay lại</a>
              <button type="submit" class="btn btn-premium flex-fill py-3 shadow">CẬP NHẬT SẢN PHẨM</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layout/footer') %>